{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Shared scanner logic (ADR 0034), resolved from source */
    "paths": {
      "@wutheringtools/scanner-core": ["./packages/scanner-core/src/index.ts"],
      "@wutheringtools/scanner-core/*": ["./packages/scanner-core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", ".d.ts", "packages/scanner-core/src/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
